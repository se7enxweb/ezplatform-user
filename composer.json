{
    "name": "se7enxweb/ezplatform-user",
    "description": "Exponential Platform User bundle",
    "type": "ezplatform-bundle",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "EzSystems\\EzPlatformUserBundle\\": "src/bundle/",
            "EzSystems\\EzPlatformUser\\": "src/lib/",
            "Ibexa\\User\\": "src/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EzSystems\\EzPlatformUserBundle\\Tests\\": "tests/bundle/",
            "EzSystems\\EzPlatformUser\\Tests\\": "tests/lib/"
        }
    },
    "require": {
        "php": "^7.3 || ^8.0 || ^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "se7enxweb/ezplatform-kernel": "^1.3@dev",
        "se7enxweb/ezplatform-admin-ui": "^2.0@dev",
        "jms/translation-bundle": "^1.5",
        "symfony/dependency-injection": "^5.0",
        "symfony/http-kernel": "^5.0",
        "symfony/translation": "^5.0",
        "symfony/security-core": "^5.0",
        "symfony/http-foundation": "^5.0",
        "symfony/config": "^5.0",
        "symfony/options-resolver": "^5.0",
        "symfony/event-dispatcher": "^5.0",
        "symfony/intl": "^5.0",
        "symfony/validator": "^5.0",
        "symfony/form": "^5.0",
        "symfony/routing": "^5.0",
        "symfony/swiftmailer-bundle": "^3.4",
        "twig/twig": "^3.0",
        "symfony/security-http": "^5.0"
    },
    "require-dev": {
        "ibexa/ci-scripts": "^0.1@dev",
        "se7enxweb/doctrine-dbal-schema": "^1.0@dev",
        "se7enxweb/ez-support-tools": "^2.0@dev",
        "se7enxweb/ezplatform-content-forms": "^1.0@dev",
        "se7enxweb/ezplatform-core": "^2.3@dev",
        "se7enxweb/ezplatform-design-engine": "^3.0@dev",
        "se7enxweb/ezplatform-http-cache": "^2.3@dev",
        "se7enxweb/ezplatform-richtext": "^2.0@dev",
        "se7enxweb/ezplatform-rest": "^1.0@dev",
        "se7enxweb/ezplatform-search": "^1.2@dev",
        "friendsofphp/php-cs-fixer": "^2.16.0",
        "se7enxweb/ezplatform-code-style": "^0.1.0",
        "phpunit/phpunit": "^8.2",
        "matthiasnoback/symfony-dependency-injection-test": "4.3"
    },
    "scripts": {
        "fix-cs": "php-cs-fixer fix -v --show-progress=estimating",
        "check-cs": "@fix-cs --dry-run",
        "test": "phpunit -c phpunit.xml"
    },
    "replace": {
        "ezsystems/ezplatform-user": "self.version"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.3.x-dev"
        }
    }
}
